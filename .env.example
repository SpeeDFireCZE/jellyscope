# ---------------------------------------------------------------------------
# Jellyscope - configuration
#
# Copy this file as ".env" (without ".example") and fill in your values.
# .env is in .gitignore, so it never ends up in git.
#
# Only what the app needs BEFORE it can open the database lives here.
# Everything else - the Jellyfin connection, data source, tasks, language -
# is configured in the app itself and stored in the database.
# ---------------------------------------------------------------------------

# Your Jellyfin server address. No trailing slash.
# Examples: http://localhost:8096 | http://192.168.1.10:8096 | https://jellyfin.example.com
#
# Only used to pre-fill the form on the very first start; after that the
# address is taken from the database (Settings -> Jellyfin).
JELLYFIN_URL=http://localhost:8096

# Jellyfin API key: Dashboard -> Advanced -> API Keys -> "+"
# Same as above - a first-start convenience, nothing more.
JELLYFIN_API_KEY=paste-your-api-key-here

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# There is no password here. The app is always behind a login and accounts
# are created in it: the first start asks you to create an administrator,
# further users are added in Settings -> Accounts.
# Forgot your password?   python manage.py heslo <name>

# The secret that signs the login cookie.
#
# Leave it empty and the app generates a random one into data/secret_key -
# sign-in stays safe without you doing anything. Set your own when you want
# to manage the key yourself (a shared key across two installations, or
# keeping it out of the data folder).
#
# IMPORTANT: changing it signs everybody out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# 127.0.0.1 = reachable from this machine only (safest)
# 0.0.0.0   = reachable from the whole network - only if you know why
#
# Behind a reverse proxy keep 127.0.0.1; the outside world goes through it.
#
# In Docker, HOST is set to 0.0.0.0 inside the container (nobody can reach
# 127.0.0.1 in there) and what decides who gets in is BIND below. PORT is
# read by both, so changing it here changes it everywhere.
HOST=127.0.0.1
PORT=8097

# --- only when running behind a reverse proxy with HTTPS -------------------
# See DEPLOY.md
#
# Sends the login cookie over encrypted connections only.
# CAREFUL: without working HTTPS nobody can sign in with this turned on.
SECURE_COOKIES=

# Whose X-Forwarded-* headers to trust (real client address, http/https).
# Empty = nobody's. Behind nginx on the same machine set 127.0.0.1;
# without a limit anyone could forge those headers.
#
# It also decides what the failed-login block sees: without it every
# request looks like it comes from the proxy, so one block would lock
# out everybody at once.
FORWARDED_ALLOW_IPS=

# Where the database goes (SQLite = one file, no database server needed).
DATABASE_PATH=data/jellyscope.db

# ---------------------------------------------------------------------------
# Docker only
#
# docker compose reads this same file, so everything above applies to the
# container as well - PORT included. These four are the ones that only mean
# something there; without Docker they are ignored.
# ---------------------------------------------------------------------------

# Which address on the HOST publishes the port.
#   127.0.0.1  this machine only - the right answer behind a reverse proxy
#   0.0.0.0    the whole network - when there is no proxy in front
BIND=127.0.0.1

# Where the data folder lives on the host. A path, not a named volume, so a
# backup is a plain copy of a folder.
DATA_DIR=./data

# 1 = the image includes ffmpeg, so the ffprobe data source works
# 0 = ~250 MB smaller image, technical data limited to what Jellyfin reports
FFPROBE=1

# 1 = the image includes pg_dump, used when backing up PostgreSQL
# 0 = ~30 MB smaller; backups fall back to the app's own export
# Irrelevant with SQLite, which backs itself up.
PGDUMP=1

# The container's time zone. Without it it runs in UTC and the evening peak
# in the charts shifts by a couple of hours.
TZ=Europe/Prague
