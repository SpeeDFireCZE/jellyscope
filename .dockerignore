# What does not belong in the image.
#
# Above all `data/` and `.env`. The database and the secret key belong in
# a volume and in the environment, not in the image - an image gets passed
# on, data does not.
data/
.venv/
venv/
__pycache__/
*.py[cod]

.git/
.github/
.gitignore
.gitattributes

.env
*.db
*.db-wal
*.db-shm

.vscode/
.idea/
Thumbs.db
desktop.ini
